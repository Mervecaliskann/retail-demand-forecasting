# Kaggle data files: download yourself, never commit
# Kaggle veri dosyaları: kendin indir, asla commit etme
data/

# Virtual environment and Python cache
# Sanal ortam ve Python önbelleği
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Large intermediate files (the pipeline creates them again)
# Büyük ara dosyalar (pipeline tekrar üretir)
*.parquet
*.pkl
